{
  "name": "chatbot",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm start --workspace=server",
    "build:web": "npm run build --workspace=web",
    "start:server": "npm start --workspace=server",
    "lint": "eslint web/src --fix && npm run lint --workspace=server",
    "lint:check": "eslint web/src && npm run lint:check --workspace=server",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,less,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,less,css}\"",
    "stylelint": "stylelint \"web/src/**/*.less\" --fix",
    "stylelint:check": "stylelint \"web/src/**/*.less\"",
    "check:all": "npm run check:harness && npm run format:check && npm run lint:check && npm run stylelint:check && npm run test --workspace=web && npm run build:web",
    "check:harness": "node scripts/check-harness.mjs",
    "cm": "git config --unset lint.skipLintStaged; czg",
    "commit": "git add -A && lint-staged && git config lint.skipLintStaged true && czg; git config --unset lint.skipLintStaged",
    "type-check": "npm run type-check --workspace=web",
    "check:strict": "npm run format:check && npm run lint:check && npm run stylelint:check && npm run type-check",
    "prepare": "husky",
    "postinstall": "node scripts/sync-ignore.js && node scripts/sync-skills.js",
    "sync:ignore": "node scripts/sync-ignore.js",
    "sync:skills": "node scripts/sync-skills.js",
    "sync:agents": "node scripts/sync-ignore.js && node scripts/sync-skills.js"
  },
  "lint-staged": {
    "web/src/**/*.{ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write",
      "sh -c \"cd web && npm run test:changed\""
    ],
    "server/**/*.{js,cjs}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{ts,tsx,js}": [
      "prettier --write"
    ],
    "*.{less,css}": [
      "stylelint --fix --cache",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "@commitlint/cz-commitlint": "^18.6.1",
    "@eslint/js": "10.0.1",
    "concurrently": "^9.1.2",
    "czg": "^1.14.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "husky": "9.1.7",
    "less": "^4.8.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-compact-markdown-table": "^0.1.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-less": "4.2.1",
    "typescript-eslint": "8.67.0"
  }
}
